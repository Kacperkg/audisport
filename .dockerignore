!pnpm-lock.yaml
!index.html
!vite.config.ts
!tsconfig.json
!tailwind.config.js
!src/
!src/**
!public/
!public/**
!deploy/
!deploy/nginx.conf
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.git
**/.npmrc
**/.netrc
**/.ssh
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.tfstate*
